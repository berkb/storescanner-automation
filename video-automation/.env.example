# ─── Buffer ───────────────────────────────────────────────────────────────────
# Buffer → Settings → Apps → Access Token
BUFFER_ACCESS_TOKEN=

# Buffer'daki profile ID'leri (virgülle ayır)
# Nasıl bulunur: node -e "import('./scripts/upload/buffer.mjs').then(m=>m.getProfiles()).then(console.log)"
# örn: "507f1f77bcf86cd799439011,507f1f77bcf86cd799439012,507f1f77bcf86cd799439013"
BUFFER_PROFILE_IDS=

# ─── Platform geçiş bayrakları (test için) ────────────────────────────────────
# Buffer post oluşturmadan sadece video üretmek için:
SKIP_UPLOAD=false
