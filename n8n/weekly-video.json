            "node": "Başarılı mı?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1 Video Render Et": {
      "main": [
        [
          {
            "node": "Render Sonucu Kontrol",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}